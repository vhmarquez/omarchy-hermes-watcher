#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
plugin_root="$(cd -- "$script_dir/.." && pwd -P)"
hermes_root="${HERMES_ROOT:-$HOME/.hermes}"
data_parent="${XDG_DATA_HOME:-$HOME/.local/share}"
plugin_name="omarchy-bot-status"
reserved_profiles=" hermes test tmp root sudo "

lock_path="${XDG_RUNTIME_DIR:-/tmp}/vhm-hermes-bots-${UID}.lock"
[[ ! -L "$lock_path" && ( ! -e "$lock_path" || -f "$lock_path" ) ]] || {
  printf 'Refusing unsafe managed lock path: %s\n' "$lock_path" >&2
  exit 1
}
exec 9>>"$lock_path"
lock_fd="/proc/$$/fd/9"
[[ ! -L "$lock_path" && "$(stat -Lc '%d:%i' -- "$lock_path")" == "$(stat -Lc '%d:%i' -- "$lock_fd")" ]] || {
  printf 'Managed lock changed while opening: %s\n' "$lock_path" >&2
  exit 1
}
lock_type="$(stat -Lc '%F' -- "$lock_fd")"
lock_uid="$(stat -Lc '%u' -- "$lock_fd")"
lock_links="$(stat -Lc '%h' -- "$lock_fd")"
[[ "$lock_type" == regular* && "$lock_uid" == "$UID" && "$lock_links" == 1 ]] || {
  printf 'Refusing unsafe managed lock file: %s\n' "$lock_path" >&2
  exit 1
}
chmod 0600 -- "$lock_fd"
flock 9

mkdir -p -- "$data_parent"
data_parent="$(cd -- "$data_parent" && pwd -P)"
data_root="$data_parent/vhm.hermes-bots"
if [[ -L "$data_root" || ( -e "$data_root" && ! -d "$data_root" ) ]]; then
  printf 'Refusing symlinked managed data root: %s\n' "$data_root" >&2
  exit 1
fi

if [[ ${1:-} == "--if-disabled" ]]; then
  plugins="$(timeout 2 omarchy-shell shell listPlugins 2>/dev/null)" || exit 0
  if ! jq -e --arg id "vhm.hermes-bots" '
    type == "array"
    and all(.[]; type == "object")
    and all(map(select(.id == $id))[]; (.enabled | type) == "boolean")
  ' <<<"$plugins" >/dev/null 2>&1; then
    exit 0
  fi
  if jq -e --arg id "vhm.hermes-bots" 'any(.[]; .id == $id and .enabled == true)' <<<"$plugins" >/dev/null; then
    exit 0
  fi
  shift
fi
[[ $# -eq 0 ]] || { printf 'Unknown argument: %s\n' "$1" >&2; exit 2; }

observer_source="$data_root/hermes-plugin"
scripts_dir="$data_root/scripts"
for managed in "$observer_source" "$scripts_dir" "$scripts_dir/remove-profiles" "$scripts_dir/cleanup-observer"; do
  [[ ! -L "$managed" ]] || { printf 'Refusing symlinked managed path: %s\n' "$managed" >&2; exit 1; }
done
[[ ! -L "$data_root/.initialized" ]] || { printf 'Refusing symlinked marker: %s\n' "$data_root/.initialized" >&2; exit 1; }

remove_for_profile() {
  local profile="$1"
  local profile_home="$2"
  local status
  local result
  [[ "$profile" == "default" || ( "$profile" =~ ^[a-z0-9][a-z0-9_-]{0,63}$
    && "$reserved_profiles" != *" $profile "* ) ]] || {
    printf 'Ignoring noncanonical Hermes profile name: %s\n' "$profile" >&2
    return 0
  }
  if ! status="$(python3 "$script_dir/profile_installer.py" profile-link-status "$profile_home" "$observer_source")"; then
    printf 'Could not inspect observer link for Hermes profile: %s\n' "$profile" >&2
    return 1
  fi
  if [[ "$status" == "unrelated" ]]; then
    printf 'Left unrelated profile plugin path untouched: %s\n' "$profile_home/plugins/$plugin_name" >&2
    return 0
  fi
  [[ "$status" == "managed" ]] || return 0

  if [[ "$profile" == "default" ]]; then
    if ! HERMES_HOME="$profile_home" hermes --profile default plugins disable "$plugin_name"; then
      printf 'Could not disable observer for Hermes profile: %s\n' "$profile" >&2
      return 1
    fi
  else
    if ! HERMES_HOME="$profile_home" hermes -p "$profile" plugins disable "$plugin_name"; then
      printf 'Could not disable observer for Hermes profile: %s\n' "$profile" >&2
      return 1
    fi
  fi
  if ! result="$(python3 "$script_dir/profile_installer.py" remove-profile-link "$profile_home" "$observer_source")"; then
    printf 'Could not remove observer link for Hermes profile: %s\n' "$profile" >&2
    return 1
  fi
  if [[ "$result" == "unrelated" ]]; then
    printf 'Observer path changed after disable and was left untouched: %s\n' "$profile_home/plugins/$plugin_name" >&2
    return 0
  fi
  [[ "$result" == "removed" || "$result" == "absent" ]] || return 1
  printf 'Disabled observer for Hermes profile: %s\n' "$profile"
}

remove_failures=0
if [[ -d "$hermes_root" ]]; then
  remove_for_profile default "$hermes_root" || remove_failures=1
fi

shopt -s nullglob
for profile_home in "$hermes_root"/profiles/*; do
  [[ -d "$profile_home" && ! -L "$profile_home" ]] || continue
  remove_for_profile "$(basename -- "$profile_home")" "$profile_home" || remove_failures=1
done

if (( remove_failures )); then
  printf 'Hermes Watcher observer removal incomplete; managed payload retained for retry.\n' >&2
  exit 1
fi
python3 "$script_dir/profile_installer.py" remove-data "$data_parent"
printf 'Hermes Watcher observer removal complete. Restart running Hermes processes.\n'
