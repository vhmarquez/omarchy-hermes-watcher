#!/usr/bin/env bash
set -euo pipefail

sleep "${VHM_CLEANUP_DELAY_SEC:-1}"

data_parent="${XDG_DATA_HOME:-$HOME/.local/share}"
mkdir -p -- "$data_parent"
data_parent="$(cd -- "$data_parent" && pwd -P)"
data_root="$data_parent/vhm.hermes-bots"
remove_script="$data_root/scripts/remove-profiles"
[[ ! -L "$data_root" && ! -L "$data_root/scripts" && ! -L "$remove_script" ]] || exit 1
[[ -x "$remove_script" ]] || exit 0
exec "$remove_script" --if-disabled
